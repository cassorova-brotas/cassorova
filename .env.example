# Copie para .env (local) ou cadastre como "Variables" no GitHub (Settings > Secrets and variables > Actions > Variables).
# Contêiner do Google Tag Manager (centraliza GA4, Google Ads e Meta Pixel).
# No endereço provisório deixe VAZIO (PUBLIC_GTM_ID=) para não sujar os dados do GA4 e do Ads. Só preencha no definitivo.
PUBLIC_GTM_ID=GTM-N5M2VBV
# IDs da Cassorova (já configurados DENTRO do GTM, não repetir aqui para não contar em dobro):
#   GA4: G-81T3FDT83W | Google Ads: conta 771-172-8329 | Pixel da Meta (Cassorova Ads): 814372796152066
# Só use as linhas abaixo se NÃO usar o GTM (carregamento direto, respeitando o consentimento).
PUBLIC_GA4_ID=
PUBLIC_ADS_ID=
PUBLIC_META_PIXEL_ID=
# Endereço provisório: true bloqueia o Google (noindex e robots). No endereço definitivo: false.
PUBLIC_NOINDEX=true
