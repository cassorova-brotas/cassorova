---
// Gera as 15 páginas a partir de src/data/pages.ts (dados de SEO) e src/fragments/<chave>.html (conteúdo).
import Base from '../layouts/Base.astro';
import { PAGINAS } from '../data/pages';

export function getStaticPaths() {
  return PAGINAS.map((p) => ({
    params: { slug: p.path === '/' ? undefined : p.path.replace(/^\/|\/$/g, '') },
    props: { pagina: p },
  }));
}

const { pagina } = Astro.props;
const arquivos = import.meta.glob('../fragments/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const html = arquivos[`../fragments/${pagina.chave}.html`];
---
<Base title={pagina.title} description={pagina.description} path={pagina.path} og={pagina.og} noindex={pagina.noindex}>
  <Fragment set:html={html} />
</Base>
