---
// Rodapé global do Cassorova: duas ações (hospedagem e day use), links por negócio, contato e dados legais.
import { linkWhatsapp } from '../data/site';
const ano = new Date().getFullYear();
const wa = linkWhatsapp(Astro.url.pathname);
---
<footer class="csr-ft" id="csr-ft">
<section class="csr-ft__duas" aria-label="Escolha como visitar">
<div class="csr-ft__duas-in">
<article class="csr-ft__via csr-ft__via--hosp">
<h2>Hospedagem</h2>
<p>Bangalôs com ofurô e lareira, café da manhã e as duas cachoeiras durante toda a estadia.</p>
<a class="csr-ft__btn csr-ft__btn--hosp" href="https://hbook.hsystem.com.br/Booking?companyId=5fecdb7cab41d438f48d3cee" data-cnv-cta="reservar-hospedagem" data-cnv-pos="rodape">Ver disponibilidade e preços</a>
</article>
<article class="csr-ft__via csr-ft__via--eco">
<h2>Day use</h2>
<p>Das 9h às 17h, todos os dias, com cachoeiras, trilhas e estrutura de lazer.</p>
<a class="csr-ft__btn csr-ft__btn--eco" href="https://reservas.cassorova.com.br/passeio/day-use" data-cnv-cta="comprar-day-use" data-cnv-pos="rodape">Comprar o day use</a>
</article>
</div>
</section>
<div class="csr-ft__in">
<div class="csr-ft__grade">
<div class="csr-ft__marca">
<a class="csr-ft__logo" href="/" aria-label="Cassorova Resort e Ecoturismo, página inicial" data-cnv-cta="logo" data-cnv-pos="rodape"><img src="/images/2025/03/cassorova-resort-ecoturismo.png" width="323" height="67" alt="Cassorova Resort e Ecoturismo" loading="lazy" decoding="async"></a>
<p>Brotas, São Paulo<br>Patrimônio de São Sebastião da Serra</p>
<ul class="csr-ft__social" aria-label="Redes sociais">
<li><a href="https://www.instagram.com/cassorovaresort" target="_blank" rel="noopener" aria-label="Instagram do Cassorova" data-cnv-cta="instagram" data-cnv-pos="rodape"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4.5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="16.8" cy="7.2" r="1.2" fill="currentColor"/></svg></a></li>
<li><a href="https://www.facebook.com/cassorovaresort/" target="_blank" rel="noopener" aria-label="Facebook do Cassorova" data-cnv-cta="facebook" data-cnv-pos="rodape"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.6h2.6l.4-3h-3V8.5c0-.9.3-1.5 1.5-1.5h1.6V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21z"/></svg></a></li>
<li><a href="https://www.tripadvisor.com.br/Hotel_Review-g793338-d21389571-Reviews-Cassorova_Hotel_Boutique-Brotas_State_of_Sao_Paulo.html" target="_blank" rel="noopener" aria-label="Cassorova no Tripadvisor" data-cnv-cta="tripadvisor" data-cnv-pos="rodape"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="7.6" cy="13.2" r="3.1" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="16.4" cy="13.2" r="3.1" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="7.6" cy="13.2" r="1" fill="currentColor"/><circle cx="16.4" cy="13.2" r="1" fill="currentColor"/><path d="M2.6 9.4c2.4-2 5.5-3 9.4-3s7 1 9.4 3M9 17.6l3 2.4 3-2.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
<li><a href="https://www.google.com/maps/@-22.414687,-47.992489,17z" target="_blank" rel="noopener" aria-label="Como chegar ao Cassorova, no mapa" data-cnv-cta="mapa" data-cnv-pos="rodape"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.8a6.2 6.2 0 0 0-6.2 6.2c0 4.5 6.2 12.2 6.2 12.2s6.2-7.7 6.2-12.2A6.2 6.2 0 0 0 12 2.8zm0 8.5a2.3 2.3 0 1 1 0-4.6 2.3 2.3 0 0 1 0 4.6z"/></svg></a></li>
</ul>
</div>
<nav class="csr-ft__col" aria-labelledby="csr-ft-r">
<h2 id="csr-ft-r">Resort</h2>
<ul>
<li><a href="/bangalos/" data-cnv-cta="rodape-bangalos" data-cnv-pos="rodape">Bangalôs</a></li>
<li><a href="/lazer/" data-cnv-cta="rodape-lazer" data-cnv-pos="rodape">Lazer</a></li>
<li><a href="/cachoeiras/" data-cnv-cta="rodape-cachoeiras" data-cnv-pos="rodape">Cachoeiras</a></li>
<li><a href="/gastronomia/" data-cnv-cta="rodape-gastronomia" data-cnv-pos="rodape">Gastronomia</a></li>
<li><a href="/experiencias/" data-cnv-cta="rodape-experiencias" data-cnv-pos="rodape">Experiências</a></li>
<li><a href="/pacotes/" data-cnv-cta="rodape-pacotes" data-cnv-pos="rodape">Pacotes</a></li>
</ul>
</nav>
<nav class="csr-ft__col" aria-labelledby="csr-ft-e">
<h2 id="csr-ft-e">Visite</h2>
<ul>
<li><a href="/day-use/" data-cnv-cta="rodape-day-use" data-cnv-pos="rodape">Day use</a></li>
<li><a href="/reservas/#cnv-como-chegar" data-cnv-cta="rodape-como-chegar" data-cnv-pos="rodape">Como chegar</a></li>
<li><a href="/reservas/#cnv-contato" data-cnv-cta="rodape-contato" data-cnv-pos="rodape">Contato e reservas</a></li>
</ul>
</nav>
<section class="csr-ft__col" aria-labelledby="csr-ft-c">
<h2 id="csr-ft-c">Contato</h2>
<ul>
<li><a href={wa} target="_blank" rel="noopener" data-cnv-cta="telefone" data-cnv-pos="rodape">WhatsApp (14) 99106-8097</a></li>
<li><a href="mailto:resort@cassorova.com.br" data-cnv-cta="email" data-cnv-pos="rodape">resort@cassorova.com.br</a></li>
<li class="csr-ft__txt">Hospedagem: check-in 16h, check-out 14h</li>
<li class="csr-ft__txt">Day use: 9h às 17h, todos os dias</li>
</ul>
<p class="csr-ft__dist">De carro: São Paulo 217 km, Ribeirão Preto 173 km, São José do Rio Preto 278 km.</p>
</section>
</div>
<div class="csr-ft__base">
<p>© {ano} Cassorova Resort e Ecoturismo. CNPJ 02.216.704/0001-21</p>
<ul>
<li><a href="/termos-e-condicoes/" data-cnv-cta="termos" data-cnv-pos="rodape">Termos e condições</a></li>
<li><a href="/politica-de-privacidade/" data-cnv-cta="privacidade" data-cnv-pos="rodape">Privacidade e cookies</a></li>
<li><button type="button" data-csr-cookies data-cnv-cta="preferencias-cookies" data-cnv-pos="rodape">Preferências de cookies</button></li>
</ul>
</div>
</div>
<a class="csr-wa-flutuante" href={wa} target="_blank" rel="noopener" aria-label="Falar com o Cassorova no WhatsApp" data-cnv-cta="whatsapp-flutuante" data-cnv-pos="flutuante"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg></a>
</footer>
<style>
.csr-ft{--mata:#303323;--linho:#f3f2ee;--oliva:#756a48;--oliva-h:#635a3c;--terracota:#a65635;--terracota-h:#8f4a2d;--cobre:#d4957a;--wa:#0d7f33;position:relative;background:var(--mata);color:#fff;font-family:"Albert Sans",Helvetica,Arial,sans-serif;font-weight:300;font-size:17px;line-height:1.5}
.csr-ft *,.csr-ft *::before,.csr-ft *::after{box-sizing:border-box}
.csr-ft ul{list-style:none;margin:0;padding:0}
.csr-ft p,.csr-ft h2{margin:0}
.csr-ft a{color:inherit;text-decoration:none}
.csr-ft button{font:inherit;color:inherit;background:none;border:0;padding:0;margin:0;cursor:pointer}
.csr-ft :focus-visible{outline:2px solid var(--cobre);outline-offset:3px}
/* Duas vias */
.csr-ft__duas{background:var(--linho);color:var(--mata)}
.csr-ft__duas-in{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(16px,3vw,32px);width:min(1200px,88%);margin-inline:auto;padding:clamp(40px,5vw,64px) 0}
.csr-ft__via{display:flex;flex-direction:column;align-items:flex-start;padding:clamp(24px,3vw,40px);background:#fff;box-shadow:0 0 0 1px rgba(48,51,35,.14)}
.csr-ft__via h2{font-family:"Gilda Display",Georgia,serif;font-weight:400;font-size:clamp(30px,2vw + 20px,42px);line-height:1.05;color:var(--mata)}
.csr-ft__via p{margin-top:10px;max-width:42ch;font-size:18px;color:#564944}
.csr-ft .csr-ft__btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;margin-top:22px;padding:0 24px;border-radius:4px;font-size:17px;font-weight:600;color:#fff;transition:background-color .2s ease}
.csr-ft__btn--hosp{background:var(--terracota)}.csr-ft__btn--hosp:hover{background:var(--terracota-h)}
.csr-ft__btn--eco{background:var(--oliva)}.csr-ft__btn--eco:hover{background:var(--oliva-h)}
.csr-ft__via--hosp{border-top:4px solid var(--terracota)}
.csr-ft__via--eco{border-top:4px solid var(--oliva)}
/* Links */
.csr-ft__in{width:min(1200px,88%);margin-inline:auto;padding:clamp(44px,5vw,64px) 0 28px}
.csr-ft__grade{display:grid;grid-template-columns:1.3fr 1fr 1fr 1.3fr;gap:clamp(28px,3.5vw,56px)}
.csr-ft__logo{display:block;width:190px}
.csr-ft__logo img{display:block;width:100%;height:auto}
.csr-ft__marca p{margin-top:16px;font-size:16px;color:rgba(255,255,255,.85)}
.csr-ft__social{display:flex;gap:8px;margin-top:18px}
.csr-ft__social a{display:grid;place-items:center;width:44px;height:44px;border:1px solid rgba(255,255,255,.6);border-radius:50%;transition:background-color .2s ease}
.csr-ft__social a:hover{background:rgba(255,255,255,.16)}
.csr-ft__social svg{width:20px;height:20px}
.csr-ft__col h2{margin-bottom:10px;font-family:"Gilda Display",Georgia,serif;font-weight:400;font-size:26px;line-height:1.1;color:var(--cobre)}
.csr-ft__col li a{display:inline-flex;align-items:center;min-height:40px}
.csr-ft__col li a:hover{text-decoration:underline;text-underline-offset:4px}
.csr-ft__txt{padding:6px 0;font-size:16px;color:rgba(255,255,255,.85)}
.csr-ft__dist{margin-top:10px;font-size:15px;line-height:1.5;color:rgba(255,255,255,.72)}
.csr-ft__base{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px 32px;margin-top:clamp(36px,4vw,52px);padding-top:18px;border-top:1px solid rgba(255,255,255,.2);font-size:15px}
.csr-ft__base ul{display:flex;flex-wrap:wrap;gap:0 24px}
.csr-ft__base a,.csr-ft__base button{display:inline-flex;align-items:center;min-height:44px;text-decoration:underline;text-underline-offset:4px;text-decoration-color:rgba(255,255,255,.4)}
.csr-ft__base a:hover,.csr-ft__base button:hover{color:var(--cobre)}
.csr-wa-flutuante{position:fixed;right:18px;bottom:18px;z-index:900;display:none;place-items:center;width:58px;height:58px;border-radius:50%;background:var(--wa);color:#fff;box-shadow:0 6px 18px rgba(0,0,0,.35);transition:transform .2s ease}
.csr-wa-flutuante:hover{transform:scale(1.06)}
.csr-wa-flutuante svg{width:32px;height:32px}
@media (min-width:1100px){.csr-wa-flutuante{display:grid}}
@media (max-width:1099px){
.csr-ft{padding-bottom:76px}
.csr-ft__grade{grid-template-columns:repeat(2,minmax(0,1fr))}
.csr-ft__marca{grid-column:1/-1}
}
@media (max-width:700px){
.csr-ft__duas-in{grid-template-columns:minmax(0,1fr)}
.csr-ft__btn{width:100%}
.csr-ft__grade{grid-template-columns:minmax(0,1fr)}
.csr-ft__base{flex-direction:column;align-items:flex-start}
}
@media (prefers-reduced-motion:reduce){.csr-wa-flutuante,.csr-ft__social a,.csr-ft__btn{transition:none}.csr-wa-flutuante:hover{transform:none}}
</style>
<script is:inline>
(function(){
// Rastreamento dos cliques do cabeçalho, do menu, da barra do celular e do rodapé (evento cnv_cta, igual ao das páginas).
document.addEventListener('click',function(ev){
var el=ev.target;
while(el&&el!==document){
if(el.getAttribute&&el.getAttribute('data-cnv-cta')&&el.closest&&el.closest('.csr-hd, .csr-ft, .csr-barra, .csr-drawer, .csr-wa-flutuante')){
window.dataLayer=window.dataLayer||[];
window.dataLayer.push({event:'cnv_cta',cnv_cta:el.getAttribute('data-cnv-cta'),cnv_posicao:el.getAttribute('data-cnv-pos')||'',link_url:el.getAttribute('href')||''});
return;
}
el=el.parentNode;
}
});
})();
</script>
