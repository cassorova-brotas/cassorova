<style>
.csr-hd,.csr-drawer,.csr-barra{--mata:#303323;--musgo:#858666;--linho:#f3f2ee;--pedra:#564944;--oliva:#756a48;--oliva-h:#635a3c;--terracota:#a65635;--terracota-h:#8f4a2d;--cobre:#d4957a;--wa:#0f8a38;--h:68px;font-family:"Albert Sans",Helvetica,Arial,sans-serif;line-height:1.35}
html{scroll-padding-top:96px}
.csr-hd *,.csr-drawer *,.csr-barra *{box-sizing:border-box}
.csr-hd ul,.csr-drawer ul{list-style:none;margin:0;padding:0}
.csr-hd p,.csr-drawer p,.csr-drawer h2,.csr-drawer h3{margin:0}
.csr-hd a,.csr-drawer a,.csr-barra a{color:inherit;text-decoration:none}
.csr-hd button{font:inherit;color:inherit;background:none;border:0;padding:0;margin:0;cursor:pointer}
.csr-hd :focus-visible,.csr-drawer :focus-visible,.csr-barra :focus-visible{outline:2px solid var(--cobre);outline-offset:3px}
.csr-mega :focus-visible,.csr-mega__card:focus-visible{outline-color:var(--terracota)}
/* Barra */
.csr-skip{position:fixed;left:12px;top:-100px;z-index:2;padding:10px 16px;background:#fff;color:var(--mata)!important;font-size:16px}
.csr-skip:focus{top:8px}
.csr-hd{position:sticky;top:0;z-index:1000;background:var(--mata);color:#fff;font-weight:400;transition:transform .3s ease,box-shadow .3s ease}
.csr-hd.is-oculto{transform:translateY(-100%)}
.csr-hd.is-rolado{box-shadow:0 8px 24px rgba(0,0,0,.28)}
.csr-hd__in{display:flex;align-items:center;gap:clamp(16px,2vw,32px);width:min(1280px,92%);height:var(--h);margin-inline:auto}
.csr-hd__logo{display:block;flex:none;width:150px}
.csr-hd__logo img{display:block;width:100%;height:auto}
.csr-nav{display:none;flex:1;min-width:0}
.csr-nav>ul{display:flex;align-items:center;gap:2px}
.csr-hd .csr-link{display:inline-flex;align-items:center;height:44px;padding:0 14px;font-size:17px;font-weight:500;border-radius:4px;color:#fff;transition:background-color .2s ease}
.csr-hd .csr-link:hover{background:rgba(255,255,255,.12)}
.csr-hd .csr-link[aria-current="page"]{color:var(--cobre)}
.csr-hd .csr-item__btn{display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 14px;font-size:17px;font-weight:500;border-radius:4px;color:#fff;transition:background-color .2s ease}
.csr-item__btn:hover,.csr-item__btn[aria-expanded="true"]{background:rgba(255,255,255,.12)}
.csr-item__btn::after{content:"";width:6px;height:6px;margin-top:-3px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(45deg);transition:transform .2s ease}
.csr-item__btn[aria-expanded="true"]::after{margin-top:3px;transform:rotate(225deg)}
.csr-item__btn[data-ativo]{color:var(--cobre)}
.csr-acoes{display:none;align-items:center;gap:10px;margin-left:auto}
.csr-wa{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--wa);color:#fff;transition:background-color .2s ease}
.csr-wa:hover{background:#0c7230}
.csr-wa svg{width:24px;height:24px}
.csr-btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 20px;font-size:16px;font-weight:600;border-radius:4px;color:#fff;white-space:nowrap;transition:background-color .2s ease}
.csr-btn--hosp{background:var(--terracota)}.csr-btn--hosp:hover{background:var(--terracota-h)}
.csr-btn--eco{background:var(--oliva)}.csr-btn--eco:hover{background:var(--oliva-h)}
.csr-hd .csr-burger{position:relative;flex:none;width:48px;height:48px;margin-left:auto}
.csr-burger span{position:absolute;left:12px;right:12px;height:2px;background:#fff;transition:transform .25s ease,opacity .2s ease,top .25s ease}
.csr-burger span:nth-child(1){top:16px}.csr-burger span:nth-child(2){top:23px}.csr-burger span:nth-child(3){top:30px}
.csr-burger[aria-expanded="true"] span:nth-child(1){top:23px;transform:rotate(45deg)}
.csr-burger[aria-expanded="true"] span:nth-child(2){opacity:0}
.csr-burger[aria-expanded="true"] span:nth-child(3){top:23px;transform:rotate(-45deg)}
/* Menu grande (desktop) */
.csr-mega{position:absolute;left:0;right:0;top:100%;display:none;background:var(--linho);color:var(--mata);border-top:3px solid var(--cobre);box-shadow:0 22px 40px rgba(0,0,0,.22)}
.csr-item__btn[aria-expanded="true"]+.csr-mega{display:block}
.csr-mega__in{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:clamp(24px,4vw,56px);width:min(1280px,92%);margin-inline:auto;padding:30px 0 34px}
.csr-mega--resort .csr-mega__in{grid-template-columns:minmax(0,1fr) minmax(0,1fr) 300px}
.csr-mega__t{margin-bottom:12px;font-family:"Gilda Display",Georgia,serif;font-size:28px;line-height:1.1;color:var(--mata)}
.csr-mega__col ul{display:grid;grid-template-columns:minmax(0,1fr);gap:2px 28px}
.csr-mega__col a{display:block;padding:8px 14px;margin-inline:-14px;border-radius:4px;transition:background-color .2s ease}
.csr-mega__col a:hover{background:rgba(48,51,35,.08)}
.csr-mega__col b{display:block;font-size:18px;font-weight:600;color:var(--mata)}
.csr-mega__col span{display:block;margin-top:2px;font-size:15px;font-weight:300;line-height:1.4;color:var(--pedra)}
.csr-mega__card{display:block;align-self:start;overflow:hidden;border-radius:6px;background:#fff;box-shadow:0 0 0 1px rgba(48,51,35,.12)}
.csr-mega__card img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover}
.csr-mega__cta{display:block;padding:14px 18px;font-size:17px;font-weight:600;color:#fff}
.csr-mega__cta--hosp{background:var(--terracota)}.csr-mega__card:hover .csr-mega__cta--hosp{background:var(--terracota-h)}
@media (min-width:1100px){
.csr-hd{--h:80px}
.csr-hd__logo{width:176px}
.csr-nav{display:block}
.csr-acoes{display:flex}
.csr-burger{display:none}
}
@media (min-width:1100px) and (max-width:1239px){.csr-btn{padding:0 14px;font-size:15px}.csr-item__btn,.csr-hd .csr-link{padding:0 10px}}
/* Menu em tela cheia (celular e tablet) */
.csr-drawer{position:fixed;inset:0;z-index:999;overflow-y:auto;overscroll-behavior:contain;background:var(--mata);color:#fff}
.csr-drawer[hidden]{display:none}
.csr-drawer__in{width:min(640px,88%);margin-inline:auto;padding:12px 0 140px}
.csr-drawer section{padding:20px 0 6px;border-bottom:1px solid rgba(255,255,255,.16)}
.csr-drawer h3{margin:22px 0 4px;font-family:"Gilda Display",Georgia,serif;font-weight:400;font-size:24px;line-height:1.1;color:var(--cobre)}
.csr-drawer h2{margin-bottom:6px;font-family:"Gilda Display",Georgia,serif;font-weight:400;font-size:30px;line-height:1.1;color:var(--cobre)}
.csr-drawer li a{display:flex;align-items:center;min-height:52px;font-size:19px;font-weight:400}
.csr-drawer li a:active{color:var(--cobre)}
.csr-drawer__info{margin-top:22px;font-size:16px;font-weight:300;line-height:1.6;color:rgba(255,255,255,.82)}
html.csr-trava{overflow:hidden}
/* Barra de ações fixa no celular */
.csr-barra{position:fixed;left:0;right:0;bottom:0;z-index:1001;display:grid;grid-template-columns:1fr 1fr 56px;gap:8px;padding:10px 12px calc(10px + env(safe-area-inset-bottom));background:var(--mata);box-shadow:0 -8px 24px rgba(0,0,0,.25)}
.csr-barra .csr-barra__b{display:grid;place-items:center;min-height:48px;padding:0 8px;border-radius:4px;font-size:17px;font-weight:600;color:#fff;text-align:center}
.csr-barra__b--hosp{background:var(--terracota)}
.csr-barra__b--eco{background:var(--oliva)}
.csr-barra .csr-barra__wa{display:grid;place-items:center;min-height:48px;border-radius:4px;background:var(--wa);color:#fff}
.csr-barra__wa svg{width:28px;height:28px}
@media (min-width:1100px){.csr-barra{display:none}.csr-drawer{display:none!important}}
@media (prefers-reduced-motion:reduce){.csr-hd,.csr-hd *{transition:none!important}}
</style>
<script is:inline>
(function(){
var hd=document.getElementById('csr-hd');
if(!hd){return;}
var root=document.documentElement;
var burger=hd.querySelector('.csr-burger');
var drawer=document.getElementById('csr-drawer');
var barra=document.getElementById('csr-barra');
var itens=hd.querySelectorAll('.csr-item__btn');
var aberto=false;
/* Menu grande */
function fechaMega(exceto){Array.prototype.forEach.call(itens,function(b){if(b!==exceto){b.setAttribute('aria-expanded','false');}});}
var timer=null;
Array.prototype.forEach.call(itens,function(b){
var li=b.parentNode;
b.addEventListener('click',function(){var abre=b.getAttribute('aria-expanded')!=='true';fechaMega(b);b.setAttribute('aria-expanded',abre?'true':'false');});
li.addEventListener('mouseenter',function(e){if(window.matchMedia('(hover:hover)').matches){clearTimeout(timer);timer=setTimeout(function(){fechaMega(b);b.setAttribute('aria-expanded','true');},110);}});
li.addEventListener('mouseleave',function(){if(window.matchMedia('(hover:hover)').matches){clearTimeout(timer);timer=setTimeout(function(){b.setAttribute('aria-expanded','false');},180);}});
li.addEventListener('focusout',function(e){if(!li.contains(e.relatedTarget)){b.setAttribute('aria-expanded','false');}});
});
document.addEventListener('click',function(e){if(!hd.contains(e.target)){fechaMega(null);}});
/* Menu em tela cheia: abre, trava a rolagem e isola o resto da página */
function isola(on){
Array.prototype.forEach.call(document.body.children,function(el){
if(el===hd||el===drawer||el===barra||el.contains(hd)){return;}
if(on){el.setAttribute('inert','');}else{el.removeAttribute('inert');}
});
}
function abre(on){
aberto=on;
burger.setAttribute('aria-expanded',on?'true':'false');
burger.setAttribute('aria-label',on?'Fechar menu':'Abrir menu');
drawer.hidden=!on;
root.classList.toggle('csr-trava',on);
barra.style.display=on?'none':'';
hd.classList.remove('is-oculto');
isola(on);
if(on){drawer.style.top=Math.max(0,hd.getBoundingClientRect().bottom)+'px';drawer.scrollTop=0;}else{burger.focus();}
}
burger.addEventListener('click',function(){abre(!aberto);});
drawer.addEventListener('click',function(e){var a=e.target.closest?e.target.closest('a'):null;if(a){abre(false);}});
document.addEventListener('keydown',function(e){
if(e.key==='Escape'){if(aberto){abre(false);}fechaMega(null);}
if(e.key==='Tab'&&aberto){
var f=[burger].concat(Array.prototype.slice.call(drawer.querySelectorAll('a[href]')));
var i=f.indexOf(document.activeElement);
if(e.shiftKey&&i<=0){e.preventDefault();f[f.length-1].focus();}
else if(!e.shiftKey&&i===f.length-1){e.preventDefault();f[0].focus();}
}
});
window.matchMedia('(min-width:1100px)').addEventListener('change',function(m){if(m.matches&&aberto){abre(false);}});
/* Barra some ao rolar para baixo e volta ao rolar para cima */
var ult=window.pageYOffset||0,tick=false;
function rola(){
var y=window.pageYOffset||0;
hd.classList.toggle('is-rolado',y>8);
if(!aberto){
if(y>ult+6&&y>240){hd.classList.add('is-oculto');fechaMega(null);}
else if(y<ult-6||y<240){hd.classList.remove('is-oculto');}
}
ult=y;tick=false;
}
window.addEventListener('scroll',function(){if(!tick){tick=true;requestAnimationFrame(rola);}},{passive:true});
hd.addEventListener('focusin',function(){hd.classList.remove('is-oculto');});
/* Página atual */
var path=location.pathname.replace(/\/+$/,'')||'/';
Array.prototype.forEach.call(hd.querySelectorAll('.csr-nav a[href]'),function(a){
var raw=a.getAttribute('href');
if(raw.indexOf('#')>-1){return;}
var h=raw.replace(/\/+$/,'')||'/';
if(h===path){a.setAttribute('aria-current','page');var li=a.closest('.csr-item');if(li){li.querySelector('.csr-item__btn').setAttribute('data-ativo','');}}
});
})();
</script>
