---
// Banner de consentimento (LGPD + Consent Mode v2). Aceitar e Recusar têm o mesmo destaque.
// A escolha fica no navegador (localStorage "csr_consent") por 12 meses. Reabre pelo botão
// "Preferências de cookies" do rodapé (qualquer elemento com data-csr-cookies).
---
<div class="csr-ck" id="csr-ck" role="dialog" aria-labelledby="csr-ck-t" aria-describedby="csr-ck-d" hidden>
<div class="csr-ck__in">
<h2 id="csr-ck-t" tabindex="-1">Cookies e privacidade</h2>
<p id="csr-ck-d">Usamos cookies necessários para o site funcionar. Com a sua permissão, usamos também cookies de estatística, para saber como o site é usado e melhorá-lo, e de marketing, para medir e mostrar os anúncios do Cassorova. Você pode mudar a escolha quando quiser. <a href="/politica-de-privacidade/">Política de privacidade e cookies</a></p>
<div class="csr-ck__opts" id="csr-ck-opts" hidden>
<label class="csr-ck__opt"><input type="checkbox" checked disabled><span><b>Necessários</b><small>Fazem o site e o menu funcionar. Sempre ativos.</small></span></label>
<label class="csr-ck__opt"><input type="checkbox" id="csr-ck-a"><span><b>Estatística</b><small>Google Analytics: páginas visitadas e tempo no site, para melhorar o site.</small></span></label>
<label class="csr-ck__opt"><input type="checkbox" id="csr-ck-m"><span><b>Marketing</b><small>Google Ads e Meta (Facebook e Instagram): medem anúncios e mostram ofertas do Cassorova.</small></span></label>
</div>
<div class="csr-ck__btns">
<button type="button" class="csr-ck__b csr-ck__b--forte" id="csr-ck-recusa">Recusar não essenciais</button>
<button type="button" class="csr-ck__b csr-ck__b--forte" id="csr-ck-aceita">Aceitar todos</button>
<button type="button" class="csr-ck__b csr-ck__b--texto" id="csr-ck-custom" aria-expanded="false" aria-controls="csr-ck-opts">Personalizar</button>
<button type="button" class="csr-ck__b csr-ck__b--forte csr-ck__b--salva" id="csr-ck-salva" hidden>Salvar escolha</button>
</div>
</div>
</div>
<style>
.csr-ck{position:fixed;left:0;right:0;bottom:0;z-index:1200;display:flex;justify-content:center;padding:12px;font-family:"Albert Sans",Helvetica,Arial,sans-serif;pointer-events:none}
.csr-ck[hidden]{display:none}
.csr-ck *{box-sizing:border-box}
.csr-ck__in{pointer-events:auto;width:min(760px,100%);max-height:calc(100vh - 24px);overflow-y:auto;padding:22px 24px;background:#fff;color:#303323;border-top:4px solid #a65635;border-radius:6px;box-shadow:0 12px 44px rgba(0,0,0,.34)}
.csr-ck h2{margin:0 0 6px;font-family:"Gilda Display",Georgia,serif;font-weight:400;font-size:26px;line-height:1.15;color:#303323}
.csr-ck p{margin:0;font-size:16px;line-height:1.55;color:#564944}
.csr-ck a{color:#a65635;text-decoration:underline;text-underline-offset:3px}
.csr-ck__opts{display:grid;gap:10px;margin-top:16px}
.csr-ck__opts[hidden]{display:none}
.csr-ck__opt{display:flex;gap:12px;align-items:flex-start;padding:12px 14px;background:#f3f2ee;border-radius:4px;cursor:pointer}
.csr-ck__opt input{flex:none;width:22px;height:22px;margin:1px 0 0;accent-color:#756a48}
.csr-ck__opt b{display:block;font-size:17px;font-weight:600;color:#303323}
.csr-ck__opt small{display:block;margin-top:2px;font-size:15px;line-height:1.45;color:#564944}
.csr-ck__btns{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}
.csr-ck__b{min-height:48px;padding:0 22px;font:600 17px/1 "Albert Sans",Helvetica,Arial,sans-serif;border-radius:4px;border:2px solid #303323;cursor:pointer;transition:background-color .2s ease,color .2s ease}
.csr-ck__b--forte{background:#303323;color:#fff}
.csr-ck__b--forte:hover{background:#4a4e36;border-color:#4a4e36}
.csr-ck__b--texto{background:transparent;color:#303323;border-color:transparent;text-decoration:underline;text-underline-offset:4px}
.csr-ck__b--texto:hover{background:rgba(48,51,35,.08)}
.csr-ck__b--salva{margin-left:auto}
.csr-ck__b[hidden]{display:none}
.csr-ck :focus-visible{outline:3px solid #a65635;outline-offset:3px}
@media (max-width:600px){.csr-ck{padding:0}.csr-ck__in{border-radius:6px 6px 0 0;padding:18px 16px 20px}.csr-ck__b{flex:1 1 100%}.csr-ck__b--salva{margin-left:0}}
@media (prefers-reduced-motion:reduce){.csr-ck__b{transition:none}}
</style>
<script is:inline>
(function(){
var KEY='csr_consent',ano=31536000000;
var el=document.getElementById('csr-ck');
if(!el){return;}
var opts=document.getElementById('csr-ck-opts'),cA=document.getElementById('csr-ck-a'),cM=document.getElementById('csr-ck-m');
var bCustom=document.getElementById('csr-ck-custom'),bSalva=document.getElementById('csr-ck-salva');
var voltaFoco=null;
function ler(){try{var s=JSON.parse(localStorage.getItem(KEY)||'null');if(s&&s.v===1&&Date.now()-s.t<ano){return s;}}catch(e){}return null;}
function gravar(a,m){
var s={v:1,a:!!a,m:!!m,t:Date.now()};
try{localStorage.setItem(KEY,JSON.stringify(s));}catch(e){}
window.dataLayer=window.dataLayer||[];
var g=window.gtag||function(){window.dataLayer.push(arguments);};
g('consent','update',{analytics_storage:s.a?'granted':'denied',ad_storage:s.m?'granted':'denied',ad_user_data:s.m?'granted':'denied',ad_personalization:s.m?'granted':'denied'});
window.dataLayer.push({event:'csr_consent_update',csr_estatistica:s.a?'sim':'nao',csr_marketing:s.m?'sim':'nao'});
try{window.dispatchEvent(new CustomEvent('csr:consent',{detail:s}));}catch(e){}
fecha();
}
function mostraOpcoes(on){opts.hidden=!on;bSalva.hidden=!on;bCustom.setAttribute('aria-expanded',on?'true':'false');bCustom.textContent=on?'Voltar':'Personalizar';}
function abre(comOpcoes){
var s=ler();
cA.checked=!!(s&&s.a);cM.checked=!!(s&&s.m);
voltaFoco=document.activeElement;
mostraOpcoes(!!comOpcoes);
el.hidden=false;
var t=document.getElementById('csr-ck-t');if(t&&comOpcoes){t.focus();}
}
function fecha(){el.hidden=true;if(voltaFoco&&voltaFoco.focus){try{voltaFoco.focus();}catch(e){}}voltaFoco=null;}
document.getElementById('csr-ck-aceita').addEventListener('click',function(){gravar(true,true);});
document.getElementById('csr-ck-recusa').addEventListener('click',function(){gravar(false,false);});
bCustom.addEventListener('click',function(){mostraOpcoes(opts.hidden);});
bSalva.addEventListener('click',function(){gravar(cA.checked,cM.checked);});
document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!el.hidden&&ler()){fecha();}});
document.addEventListener('click',function(e){var t=e.target.closest?e.target.closest('[data-csr-cookies]'):null;if(t){e.preventDefault();abre(true);}});
window.csrConsent={abrir:function(){abre(true);},obter:ler};
if(!ler()){abre(false);}
})();
</script>
